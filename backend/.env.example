# Copie este archivo a ".env" (dentro de backend/) y complete los valores.
# Nunca commitee ".env". Ver también el ".env.example" de la raíz del
# repositorio (variables usadas por docker-compose, no por Django
# directamente) y docs/database.md.

# --- Django ---
SECRET_KEY=<clave-segura-local>
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
SYSTEM_NAME=Matriz Administrativa de Obligaciones
FRONTEND_URL=http://localhost:5173
BACKEND_PORT=8000

# --- SQL Server ---
DB_NAME=matriz_admin_dev
DB_USER=matriz_admin_user
DB_PASSWORD=<password-seguro-local>
DB_HOST=localhost
DB_PORT=1433
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=true

# --- JWT ---
JWT_SECRET_KEY=<clave-segura-local>
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Correo (por defecto, backend de consola: nada real se envía) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# --- Zona horaria del servidor (cada empresa tiene además la suya) ---
TIME_ZONE=America/Guayaquil

# --- Matriz Administrativa de Obligaciones (ver docs/matriz/despliegue.md) ---
DOCUMENT_STORAGE_BACKEND=filesystem
DOCUMENT_MAX_UPLOAD_MB=10
PERIOD_CODE_PREFIX=OBL
PERIOD_GENERATION_LEAD_DAYS=30
NOTIFICATION_MAX_ATTEMPTS=3
SCHEDULER_INTERVAL_SECONDS=300
# Correo real en producción:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.su-dominio.ec
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false          # true solo si el servidor usa SSL directo (no STARTTLS)
# EMAIL_TIMEOUT=20
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=matriz@su-dominio.ec

# --- Solo para seed_demo (datos ficticios, nunca en producción) ---
# DEMO_USERS_PASSWORD=
