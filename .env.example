# Variables usadas por docker-compose.yml (SQL Server de desarrollo) y por
# docker-compose.prod.yml (stack completo). Copie este archivo a ".env" y
# complete los valores. Nunca commitee ".env". Deben ser coherentes con
# backend/.env (DB_PASSWORD en particular).

DB_NAME=skelleton_base_dev
DB_PASSWORD=change-me
DB_PORT=1433

# --- Solo para docker-compose.prod.yml: build args del frontend ---
# Vite "hornea" estos valores en el bundle en tiempo de build (no los lee en
# runtime), así que docker compose necesita conocerlos en su propio scope de
# variables para pasarlos como --build-arg — no alcanza con que estén en
# frontend/.env. Deben coincidir con los que usaría frontend/.env en un
# despliegue sin Docker. Ver docs/deployment más abajo en el README.
VITE_APP_NAME=Skelleton Base
VITE_API_BASE_URL=http://localhost:8000/api/v1
